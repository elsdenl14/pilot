+
+/* ---- Navigation par domaines ---- */
+.dom { display: block; }
+.nav.dh { font-weight: 600; }
+.nav.dh.cur { color: #fff; }
+.nav.dh svg { flex: none; }
+.chv { margin-left: auto; display: grid; place-items: center; transition: transform 0.15s; opacity: 0.7; }
+.chv svg { width: 14px; height: 14px; }
+.dh[aria-expanded="true"] .chv { transform: rotate(90deg); }
+.dg { margin: 2px 0 6px 20px; padding-left: 8px; border-left: 1px solid rgba(255, 255, 255, 0.14); }
+.dg[hidden] { display: none; }
+.nav.sub { padding: 6px 10px; font-size: 13.5px; gap: 9px; }
+.nav.sub svg { width: 15px; height: 15px; opacity: 0.8; }
+.dsub { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; margin: -6px 0 16px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
+.dsl { font-size: 12px; font-weight: 600; color: var(--mut); margin-right: 8px; text-transform: none; white-space: nowrap; }
+.dst { border: 0; background: none; padding: 5px 11px; border-radius: 999px; color: var(--mut); font-weight: 500; font-size: 13.5px; white-space: nowrap; cursor: pointer; }
+.dst:hover { background: var(--sunk); color: var(--tx); }
+.dst[aria-current="page"] { background: var(--accb); color: var(--acc); font-weight: 600; }
+.cmdbtn { display: flex; align-items: center; gap: 8px; min-width: 220px; max-width: 340px; flex: 0 1 320px; height: 36px; padding: 0 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--sunk); color: var(--mut); font: inherit; font-size: 13.5px; cursor: pointer; }
+.cmdbtn:hover { border-color: var(--acc); color: var(--tx); }
+.cmdbtn svg { width: 16px; height: 16px; flex: none; }
+.cmdbtn span { flex: 1; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+kbd { font: inherit; font-size: 11px; padding: 1px 6px; border: 1px solid var(--line); border-radius: 4px; background: var(--panel); color: var(--mut); }
+.newbtn { margin-right: 4px; }
+body.ro .newbtn { display: none; }
+#newpop .mg { font-size: 12px; color: var(--mut); padding: 8px 14px 2px; font-weight: 600; }
+#newpop .mi svg { width: 15px; height: 15px; }
+.cmdk { position: fixed; inset: 0; background: rgba(10, 20, 40, 0.45); z-index: 100; display: flex; justify-content: center; align-items: flex-start; padding: 12vh 14px 0; }
+.cmd-box { width: min(620px, 100%); background: var(--panel); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 20px 60px rgba(10, 20, 40, 0.3); overflow: hidden; }
+.cmd-in { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--line); color: var(--mut); }
+.cmd-in svg { width: 18px; height: 18px; flex: none; }
+.cmd-in input { flex: 1; border: 0; outline: 0; background: none; font: inherit; font-size: 16px; color: var(--tx); min-width: 0; }
+.cmd-l { max-height: 52vh; overflow-y: auto; padding: 6px; }
+.cmd-g { font-size: 12px; font-weight: 600; color: var(--mut); padding: 10px 10px 4px; }
+.cmd-i { display: flex; align-items: center; gap: 12px; width: 100%; border: 0; background: none; padding: 8px 10px; border-radius: 7px; text-align: left; color: var(--tx); font: inherit; cursor: pointer; }
+.cmd-i svg { width: 17px; height: 17px; color: var(--mut); flex: none; }
+.cmd-i span { display: flex; flex-direction: column; min-width: 0; }
+.cmd-i small { color: var(--mut); font-size: 12.5px; }
+.cmd-i[aria-selected="true"], .cmd-i:hover { background: var(--accb); }
+.cmd-e { padding: 18px; color: var(--mut); margin: 0; text-align: center; }
+.cmd-f { padding: 8px 16px; border-top: 1px solid var(--line); font-size: 12px; color: var(--mut); }
+@media (max-width: 860px) {
+  .cmdbtn { min-width: 0; width: 36px; flex: none; padding: 0; justify-content: center; }
+  .cmdbtn span, .cmdbtn kbd { display: none; }
+  .dg, .chv { display: none !important; }
+}
+
+/* Accueil : vue financière */
+.acc-full { margin-top: 16px; }
+.acc-full:first-child { margin-top: 0; }
+.card.fin .ch { border-bottom: 0; }
+.fkp { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; padding: 4px 18px 6px; }
+.fk { padding: 4px 16px 8px 0; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
+.fk small { color: var(--mut); font-size: 12.5px; }
+.fk b { font-size: 22px; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; white-space: nowrap; }
+.fk b.up { color: var(--ok); } .fk b.dn { color: var(--dn); }
+.fk span { color: var(--faint); font-size: 12px; }
+.fwrap { padding: 6px 12px 0; }
+.fchart { width: 100%; height: auto; display: block; }
+.fchart .fhl { fill: var(--accb); opacity: 0; transition: opacity .12s; }
+.fchart .fcol:hover .fhl { opacity: .7; }
+.fleg { display: flex; flex-wrap: wrap; gap: 6px 20px; padding: 4px 18px 16px; color: var(--mut); font-size: 12.5px; }
+.fleg i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 7px; }
+.fleg i.ln { width: 16px; height: 3px; border-radius: 2px; background: var(--acc); vertical-align: middle; }
+@media (max-width: 760px) { .fkp { grid-template-columns: repeat(2, minmax(0, 1fr)); } .fk b { font-size: 19px; } }
