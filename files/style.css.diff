--- base/style.css	2026-11-15 02:01:00.373722545 +0000
+++ out15/style.css	2026-11-15 02:10:22.964477831 +0000
@@ -459,3 +459,10 @@
 .cat-x{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:0 0 8px}
 .cat-x .cx-f input,.cat-x .cx-f select{margin-top:3px}
 @media (max-width:760px){.cat-x{grid-template-columns:1fr 1fr}}
+
+/* Terrain, équipes et stocks (v15) */
+.afg{border-collapse:collapse;width:100%;font-size:12.5px}.afg th,.afg td{border:1px solid var(--line);padding:4px;vertical-align:top}.afg thead th{text-align:center;font-weight:600;background:var(--bg2,transparent)}
+.afg .afn{text-align:left;white-space:nowrap;min-width:130px;font-weight:400}.afg .afn small{display:block;color:var(--mut)}.afc{min-width:74px;height:38px;cursor:pointer}.afc:hover{background:var(--bg2,#f3f4f6)}.afc.bad{background:rgba(220,38,38,.13)}
+.afb{display:block;border-radius:5px;padding:1px 5px;margin-bottom:2px;font-size:11.5px;background:rgba(31,79,216,.14);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.afb.abs{background:rgba(245,158,11,.25)}.afb.indispo{background:rgba(120,120,120,.28)}.afb.loc{background:rgba(24,121,78,.2)}
+.phg{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;padding:14px 18px}.phg figure{margin:0;cursor:pointer}.phg img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:8px;border:1px solid var(--line);background:var(--bg2,#eee)}.phg figcaption{font-size:12px;color:var(--mut);margin-top:3px}
